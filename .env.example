# --- Cloud server (npm run dev:cloud / the Docker image) ---
# Postgres connection string, e.g. Supabase's session pooler. Outside production, leave unset
# to use an embedded Postgres (PGlite) stored in data/pglite.
DATABASE_URL=
# CA certificate (PEM text) the database's TLS certificate must chain to, e.g. Supabase's
# prod-ca-2021.crt. When set, the connection is encrypted and the server's identity verified.
DATABASE_CA_CERT=
# Encrypts the firm's SMTP password at rest: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=
# Other origins allowed to call the API (comma separated); the app's own origin always is
APP_ORIGIN=
# Set to false to close sign-ups, or set a code new firms must enter to sign up
ALLOW_SIGNUP=true
SIGNUP_CODE=

# --- Shared ---
PORT=3000

# --- Desktop server (npm run dev / Electron) ---
DB_PATH=
COPIES_PATH=
