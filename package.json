{
    "name": "lexledger",
    "version": "1.3.1",
    "private": true,
    "description": "Legal invoicing and billing tool",
    "main": "electron/dist/main.js",
    "scripts": {
        "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
        "dev:server": "cd server && npm run dev",
        "dev:client": "cd client && npm run dev",
        "build": "cd client && npm run build",
        "start": "cd server && npm start",
        "dev:cloud": "concurrently \"npm run dev:cloud --prefix server\" \"npm run dev:client\"",
        "build:cloud": "npm run build --prefix client && npm run build:cloud --prefix server",
        "start:cloud": "npm run start:cloud --prefix server",
        "install:all": "npm install && cd server && npm install && cd ../client && npm install",
        "electron:dev": "concurrently \"npm run dev:cloud --prefix server\" \"npm run dev:client\" \"wait-on http://localhost:5173 && electron .\"",
        "electron:compile": "tsc -p electron/tsconfig.json",
        "electron:build": "npm run electron:compile && electron-builder --mac",
        "electron:build-quick": "npm run electron:build",
        "electron:build-win": "npm run electron:compile && electron-builder --win",
        "electron:build-win-x64": "npm run electron:compile && electron-builder --win --x64",
        "electron:build-quick-win": "npm run electron:build-win"
    },
    "devDependencies": {
        "@types/node": "^24.12.0",
        "concurrently": "^8.2.2",
        "electron": "^35.0.0",
        "electron-builder": "^26.0.0",
        "typescript": "^6.0.2",
        "wait-on": "^8.0.0"
    }
}
